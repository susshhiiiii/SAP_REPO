<mvc:View
    controllerName="demo.ageeligibilitycheckup.controller.App8"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <VBox class="sapUiSmallMargin" width="20rem">

        <Title text="Checkbox Controls Visibility" class="sapUiSmallMarginBottom"/>

        <CheckBox
            text="Show Input Field"
            selected="{/isVisible}"
            select="onToggle" />

        <Input
            placeholder="Please apply for Passport ASAP"
            visible="{/isVisible}"
            class="sapUiSmallMarginTop" />

    </VBox>
</mvc:View>